#!/usr/bin/env bash
set -euo pipefail
umask 077
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
for command in python3 curl; do
  if ! command -v "$command" >/dev/null; then
    printf 'Missing %s; see docs/DEVELOPMENT.md.\n' "$command" >&2
    exit 2
  fi
done
python3 scripts/bootstrap-toolchain.py
export PATH="$PWD/.ratlas/toolchain/bin:$PWD/.ratlas/toolchain/node-24.18.0/bin:$PATH"
export RATLAS_DEV_SHELL=1
export RATLAS_DEV_PLATFORM=native
export RATLAS_NODE_VERSION=24.18.0
export RATLAS_PNPM_VERSION=10.34.0
export RATLAS_PLAYWRIGHT_VERSION=1.59.1
export RATLAS_TEST_BROWSER=firefox
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
export PLAYWRIGHT_BROWSERS_PATH="$PWD/.ratlas/firefox-runtime"
export npm_config_build_from_source=true
export npm_config_force_build=1
export npm_config_jobs=2
export npm_config_nodedir="$PWD/.ratlas/toolchain/node-24.18.0"
export npm_config_python
npm_config_python=$(command -v python3)
if [[ ${1:-} == --supervise ]]; then
  shift
  exec node scripts/supervise.mjs "$@"
fi
if (( $# == 0 )); then
  exec bash --noprofile --norc
fi
exec "$@"
