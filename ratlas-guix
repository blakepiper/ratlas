#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
toolchain_paths=$(guix build --max-jobs=0 \
  -e '(begin (load "manifest.scm") ratlas-prebuilt-packages)')
if [[ ${1:-} == --supervise ]]; then
  shift
  while IFS= read -r package_path; do
    if [[ -x "$package_path/bin/node" ]]; then
      exec "$package_path/bin/node" scripts/guix-shell.mjs "$@"
    fi
  done <<< "$toolchain_paths"
  printf 'Prebuilt Node runtime missing from Guix toolchain\n' >&2
  exit 2
fi
exec guix shell -m manifest.scm -- bash scripts/guix-env.sh "$@"
