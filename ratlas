#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if (( $# == 0 )); then
  config=config/ratlas.local.json
elif (( $# == 2 )) && [[ "$1" == --config && -n "$2" ]]; then
  config=$2
else
  printf 'Usage: ./ratlas [--config path]\n' >&2
  exit 2
fi

if [[ ! -f "$config" ]]; then
  printf 'ratlas live config is missing: %s\n' "$config" >&2
  printf 'Copy config/ratlas.example.json to config/ratlas.local.json and configure an approved public source.\n' >&2
  exit 2
fi

exec nix develop --command bash scripts/start-production.sh "$config"
